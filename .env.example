# Server
PORT=8080
ENV=dev

# PostgreSQL (with pgvector extension)
DATABASE_URL=postgres://spotgov:spotgov_pass@localhost:5432/spotgov?sslmode=disable

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-your-key-here

# Data sources
TED_BASE_URL=https://api.ted.europa.eu
DADOS_BASE_URL=https://dados.gov.pt/api/1

# Logging
LOG_LEVEL=info
