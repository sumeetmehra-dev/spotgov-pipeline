# Server
PORT=8080
ENV=dev

# PostgreSQL (with pgvector extension)
DATABASE_URL=postgres://procura:procura_pass@localhost:5432/procura?sslmode=disable

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Mistral AI (for embeddings — free tier, no credit card required)
# Sign up at https://console.mistral.ai/ and create an API key
MISTRAL_API_KEY=your-mistral-key-here

# Data sources
TED_BASE_URL=https://api.ted.europa.eu
DADOS_BASE_URL=https://dados.gov.pt/api/1

# Logging
LOG_LEVEL=info
